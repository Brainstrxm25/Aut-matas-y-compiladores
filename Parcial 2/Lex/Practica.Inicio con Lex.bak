%option noyywrap
%{
#include <stdio.h>
%}
DIGITO          [0-9]
LETRA           [a-zA-Z]
ENTERO          {DIGITO}+
DECIMAL         {DIGITO}+"."{DIGITO}+
IDENTIFICADOR   {LETRA}({LETRA}|{DIGITO}|_)*
RFC             [A-Z&]{3,4}[0-9]{6}[A-Z0-9]{3}
CURP            [A-Z][AEIOU][A-Z]{2}[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[HM](AS|BC|BS|CC|CH|CL|CM|CS|DF|DG|GR|GT|HG|JC|MC|MN|MS|NT|NL|OC|PL|QT|QR|SP|SL|SR|TC|TS|TL|VZ|YN|ZS|NE)[B-DF-HJ-NP-TV-Z]{3}[0-9A-Z][0-9]
EMAIL_INST      [a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(edu|org|gob)\.mx

%%

{ENTERO}        { printf("Entero reconocido: %s\n", yytext); }
{DECIMAL}       { printf("Decimal reconocido: %s\n", yytext); }
{RFC}           { printf("RFC reconocido: %s\n", yytext); }
{CURP}          { printf("CURP reconocido: %s\n", yytext); }
{EMAIL_INST}    { printf("Email Institucional reconocido: %s\n", yytext); }
{IDENTIFICADOR} { printf("Identificador reconocido: %s\n", yytext); }

%%

int main() {
    yylex();
    return 0;
}